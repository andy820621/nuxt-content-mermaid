{
  "name": "@barzhsieh/nuxt-content-mermaid",
  "version": "3.0.4",
  "description": "A Nuxt module designed for integrating Mermaid with `@nuxt/content`. It automatically converts `mermaid` code blocks in Markdown into responsive chart components, and supports lazy loading and dark/light theme switching.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "content",
    "nuxt-content",
    "markdown",
    "mermaid",
    "diagram",
    "mdc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andy820621/nuxt-content-mermaid.git"
  },
  "homepage": "https://nuxt-content-mermaid.barz.app",
  "bugs": {
    "url": "https://github.com/andy820621/nuxt-content-mermaid/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/barzhsieh"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm nuxt-module-build prepare && pnpm nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "pnpm nuxt-module-build build --stub && pnpm nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "release:prepare:major": "changelogen --release --major --no-commit --no-tag --no-github && pnpm install --lockfile-only --ignore-scripts",
    "release:prepare:minor": "changelogen --release --minor --no-commit --no-tag --no-github && pnpm install --lockfile-only --ignore-scripts",
    "release:prepare:patch": "changelogen --release --patch --no-commit --no-tag --no-github && pnpm install --lockfile-only --ignore-scripts",
    "test": "vitest run --exclude test/packagePrepack.test.ts && vitest run test/packagePrepack.test.ts",
    "test:package-artifact": "node scripts/release-verification/package-artifact.mjs --profile v3-known-latest",
    "test:compatibility-profile": "node scripts/release-verification/package-artifact.mjs",
    "test:package-contract": "pnpm prepack && vue-tsc -p test/release-verification/consumer-template/type-contracts/tsconfig.json --noEmit",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "verify:source": "pnpm lint && pnpm test && pnpm test:types"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:integrations",
    "defu": "catalog:dev",
    "destr": "catalog:dev",
    "html-to-image": "1.11.11",
    "mermaid": "catalog:integrations",
    "yaml": "catalog:dev"
  },
  "peerDependencies": {
    "@nuxt/content": ">=3.5.0 <4.0.0",
    "nuxt": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/content": "catalog:integrations",
    "@nuxt/devtools": "catalog:dev",
    "@nuxt/eslint-config": "catalog:dev",
    "@nuxt/module-builder": "catalog:dev",
    "@nuxt/schema": "catalog:integrations",
    "@nuxt/test-utils": "catalog:test",
    "@nuxtjs/color-mode": "catalog:dev",
    "@nuxtjs/mdc": "catalog:integrations",
    "@types/node": "catalog:types",
    "changelogen": "catalog:dev",
    "eslint": "catalog:dev",
    "nuxt": "catalog:dev",
    "playwright": "catalog:test",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:dev",
    "yaml": "catalog:dev"
  },
  "volta": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
